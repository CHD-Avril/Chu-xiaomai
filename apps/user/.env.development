# 本地开发环境变量（勿提交）
# 留空时回退到 services/supabase.js 内的默认云端配置
# 本地 Supabase（Docker）启动后，用 `supabase status` 的 URL / anon key 覆盖：
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_ANON_KEY=<本地 anon key>

# QQ 登录（Mock / 真实切换）
# Mock：本地模拟授权（apps/user/mock-qq/server.mjs，端口 3000）
# 真实：指向 QQ 互联（需 appid/secret + 已备案域名，token 交换由后端完成）
VITE_QQ_AUTH_BASE=http://localhost:3000
