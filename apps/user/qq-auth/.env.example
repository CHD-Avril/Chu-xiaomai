# 此文件仅供复制；真实密钥放在同目录 .env.local，不能加 VITE_ 前缀。
QQ_AUTH_MODE=real
QQ_AUTH_PORT=3000
QQ_APP_ID=
QQ_APP_KEY=

# 两者必须是同一个站点，callback 固定为 /qq/callback。
# 以下默认地址供本地模拟/接口测试，不代表腾讯已允许 localhost。
QQ_FRONTEND_ORIGIN=http://localhost:5173
QQ_REDIRECT_URI=http://localhost:5173/qq/callback

# QQ 互联当前登记的是 https://chuxiaomai.cyou/qq/callback。
# 使用它做真实本地联调前，必须先让本机浏览器通过受信任 HTTPS
# 将 https://chuxiaomai.cyou 的前端和 /qq/* 请求路由到本地服务。
# 仅改下面的地址不能实现本地回调；不要把真实回调发往线上旧站。
# QQ_FRONTEND_ORIGIN=https://chuxiaomai.cyou
# QQ_REDIRECT_URI=https://chuxiaomai.cyou/qq/callback
