# Install as /etc/chu-xiaomai/qq-auth.env (root:root, mode 600).
# AppKey stays on ECS, outside every web root and release archive.
NODE_ENV=production
QQ_AUTH_MODE=real
QQ_AUTH_PORT=3000
QQ_APP_ID=1905775107
QQ_APP_KEY=
QQ_FRONTEND_ORIGIN=https://chuxiaomai.cyou
QQ_REDIRECT_URI=https://chuxiaomai.cyou/qq/callback
