# Install as /etc/chu-xiaomai/qq-auth.env (root:root, mode 600).
# AppKey stays on ECS, outside every web root and release archive.
NODE_ENV=production
QQ_AUTH_MODE=real
QQ_AUTH_PORT=3000
QQ_APP_ID=1905775107
QQ_APP_KEY=
QQ_FRONTEND_ORIGIN=https://chuxiaomai.cyou
QQ_REDIRECT_URI=https://chuxiaomai.cyou/qq/callback

# Backend only: Supabase Secret key (or legacy SUPABASE_SERVICE_ROLE_KEY).
# Apply supabase-qq-participation.sql before enabling production participation.
SUPABASE_URL=https://aiblivjuhccwcwwrwxsl.supabase.co
SUPABASE_SECRET_KEY=
